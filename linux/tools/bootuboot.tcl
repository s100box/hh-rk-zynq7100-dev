#
# JTAG-boot U-Boot on the RK-ZYNQ7100.
#
#   xsdb bootuboot.tcl <ps7_init.tcl> <u-boot.bin> [jtag_cable_serial]
#
# ps7_init.tcl is generated by the PL build or linux/gen_ps7.tcl and staged
# beside Buildroot's u-boot.bin by linux/stage-tftp.sh. The cable
# serial picks the board when more than one Zynq is on the JTAG chain;
# JTAG_CABLE_SERIAL in the environment does the same. With one Zynq it can be
# left out.
#
# ⚠ THIS IS NEEDED AFTER EVERY POWER CYCLE while SW1 selects JTAG boot (both
# switches ON). A freshly powered board then runs nothing at all and its
# console is SILENT -- which reads exactly like a dead board, a wrong serial port
# or a reset line stuck low.
#
# ⚠⚠ DO NOT `dow` THE ELF. CONFIG_OF_SEPARATE=y appends the device tree to
# u-boot.bin and the ELF's program headers stop before it, so fdtdec_setup
# finds no DTB and calls hang() with the console still uninitialized: zero
# characters out, PC frozen. The raw binary goes to CONFIG_TEXT_BASE.
set ps7    [lindex $argv 0]
set uboot  [lindex $argv 1]
set serial [lindex $argv 2]
if {$serial eq "" && [info exists env(JTAG_CABLE_SERIAL)]} {
    set serial $env(JTAG_CABLE_SERIAL)
}
if {$ps7 eq "" || $uboot eq ""} {
    error "usage: xsdb bootuboot.tcl <ps7_init.tcl> <u-boot.bin> \[jtag_cable_serial]"
}
foreach f [list $ps7 $uboot] {
    if {![file exists $f]} { error "no $f" }
}

connect

# ⚠⚠ With more than one Zynq on the chain the bare name filters below match
# two targets, and `targets -set` then fails inside a procedure -- an error
# that reads like a dead board rather than like an ambiguous one. The cable
# serial disambiguates; without one, this REFUSES and lists what it found,
# because booting the wrong board is worse than not booting.
proc board_filter {serial what} {
    if {$serial ne ""} {
        return "jtag_cable_serial == \"$serial\" && name =~ \"$what\""
    }
    return "name =~ \"$what\""
}

if {$serial eq ""} {
    set apus [targets -filter {name =~ "APU*"} -target-properties]
    if {[llength $apus] > 1} {
        puts "bootuboot: [llength $apus] Zynq APUs on the JTAG chain:"
        foreach t $apus {
            set s ""
            catch {set s [dict get $t jtag_cable_serial]}
            set n ""
            catch {set n [dict get $t name]}
            puts "  $n   cable serial $s"
        }
        error "bootuboot: more than one Zynq is attached -- name the board's JTAG\
               cable serial as the third argument (or JTAG_CABLE_SERIAL) so this\
               boots the one you mean"
    }
}

targets -set -filter [board_filter $serial "APU*"]
rst -system
after 3000
targets -set -filter [board_filter $serial "ARM*Cortex-A9*#0"]
stop

source $ps7
ps7_init
ps7_post_config

# ⚠ DDR BEFORE SOFTWARE. One line that separates a DDR fault from a boot fault,
# and it costs nothing to ask before spending five minutes on the wrong one.
mwr 0x00100000 0xDEADBEEF
set got [lindex [mrd -value 0x00100000] 0]
if {$got != 0xDEADBEEF} {
    error [format "DDR did not read back: wrote 0xDEADBEEF, read 0x%08X" $got]
}
puts "bootuboot: DDR ok"

dow -data $uboot 0x04000000
# ARM state, SVC mode, interrupts masked. Outside JTAG boot mode the BootROM
# can leave the CPU in Thumb state (CPSR 0x200001DF with SW1 on SD and no
# card), and U-Boot's ARM code would then run as Thumb and do nothing.
rwr cpsr 0x1d3
rwr pc 0x04000000
con
after 2000
stop
set pc [lindex [rrd pc] end]
con
# A healthy U-Boot relocates to the top of the 1 GB DDR, so a PC around
# 0x3FFxxxxx means it is alive and one still at 0x040xxxxx means it never got
# past board_init_f.
puts "bootuboot: pc after start = $pc"
puts "bootuboot: u-boot started -- watch it on the console (UART0, 115200 8N1)"
