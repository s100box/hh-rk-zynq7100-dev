# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: 2026 Howard M. Harte
#
# U-Boot config additions for the RK-ZYNQ7100, on top of
# configs/xilinx_zynq_virt_defconfig (u-boot-xlnx xlnx_rebase_v2024.01_2024.2).
#
# XILINX_PS_INIT_FILE is the important one: SPL compiles board/ps7_init_gpl.c
# (generated by ../gen_ps7.tcl from board/ps7_config.tcl) as its DDR, MIO and
# PLL bring-up. The path is absolute and is rewritten by build.sh, because
# U-Boot resolves it relative to its own srctree.
CONFIG_XILINX_PS_INIT_FILE="@PS7_INIT_C@"

CONFIG_DEFAULT_DEVICE_TREE="zynq-rkz7100"

# ⚠ Without these two, a board that boots SPL from QSPI or SD dies silently:
# SPL prints "Trying to boot from SPI" and nothing ever follows.
#
# xilinx_zynq_virt is a MULTI-BOARD configuration. Its CONFIG_OF_LIST names
# seventeen Xilinx reference boards -- zc702, zc706, zed, microzed and so on --
# and NOT this one, so u-boot.img comes out as a FIT carrying one U-Boot and
# eighteen device trees (ours is prepended only because it is
# CONFIG_DEFAULT_DEVICE_TREE). SPL then has to pick one at runtime, and
# mach-zynq implements no board_fit_config_name_match(), so the choice is not
# ours to control.
#
# Listing only this board leaves exactly one firmware, one DTB and one
# configuration in the FIT -- nothing to pick, nothing to get wrong, and no
# foreign board's device tree in our boot flash. It also makes the image much
# smaller, which matters when it is written over JTAG or TFTP.
CONFIG_OF_LIST="zynq-rkz7100"
CONFIG_SPL_OF_LIST="zynq-rkz7100"

# ⚠ And load U-Boot as ONE contiguous read, not as a FIT.
#
# With CONFIG_SPL_LOAD_FIT (which xilinx_zynq_virt sets) u-boot.img is a FIT
# holding U-Boot and the device tree as two separate images, and SPL loads the
# tree with a SECOND, separately-offset read from the flash. On this board that
# second read comes back subtly wrong.
#
# Measured over JTAG after an SPL boot from QSPI: at U-Boot's _end
# (0x4000000+0xfe950) the device tree body is correct and unmistakably ours --
# the strings block holds "RK-ZYNQ7100" and "xlnx,zynq-7000", and
# off_dt_strings + size_dt_strings = 0x3937, matching the 0x3938 tree -- but
# the first EIGHT BYTES are not: magic reads dc4dfeed instead of d00dfeed and
# totalsize 0x66b0 instead of 0x3938. U-Boot then has no usable device tree and
# data-aborts in dev_get_uclass_plat() with the console still dark, PC parked
# in SPL's shared exception handler at 0x40, CPSR in abort mode.
#
# The QSPI is 2x W25Q256FV in DUAL PARALLEL, where spi-nor splits every access
# across both chips and halves the offset -- and spi-nor-core.c carries a
# special case for reads starting at an ODD offset in that mode. The firmware
# read, from the start of the image, is fine; the tree's own offset inside the
# FIT is the one that lands wrong, and it is the leading bytes that suffer.
#
# A legacy image is u-boot.bin -- device tree already appended contiguously --
# behind a 64-byte header, so SPL issues ONE read and there is no second offset
# to get wrong. It is also exactly what the JTAG path loads, so the two boot
# routes carry identical bytes.
#
# (CONFIG_OF_EMBED is NOT the answer: it builds, but U-Boot
# then hangs in hang() before the console comes up, on the JTAG path too.)
# (Written the kconfig way rather than =n: a disabled symbol appears in
# .config as this comment, and build.sh checks every CONFIG_ line of this
# fragment reached .config verbatim -- "=n" would never match and would fail
# the build.)
# CONFIG_SPL_LOAD_FIT is not set
CONFIG_SPL_LEGACY_IMAGE_FORMAT=y

# Console: UART0 on MIO14/15, FT2232HQ channel B.
CONFIG_BAUDRATE=115200

# ⚠ SYS_MALLOC_F_LEN stays at the base 0x800: U-Boot proper's pre-relocation
# heap, gd and stack all live in 8 KiB of OCM, and 64 KiB data-aborts. What
# exhausts the heap (-ENOMEM, then panic and a silent reset) is the number of
# nodes bound before relocation -- see zynq-rkz7100-uboot.dts.

# ---------------------------------------------------------------------------
# The boot command: TFTP on a JTAG boot, local media otherwise.
#
# A JTAG-loaded U-Boot has no saved environment (env_get_location() returns
# ENVL_NOWHERE for JTAG boot mode), so the default environment IS the boot
# procedure. This one takes a DHCP lease, fetches rkz7100-boot.scr over TFTP
# and runs it -- which fetches the DTB, kernel and ramdisk and boots them.
# The TFTP server is the one the DHCP lease names, unless the build names
# one. Any key during the countdown stops at a prompt instead; if DHCP or the
# script fails it falls back to the stock distro boot.
#
# ⚠ `setenv serverip` comes AFTER `dhcp`: the lease overwrites serverip with
# whatever the DHCP server says (usually the router). `autoload no` stops dhcp
# from trying to fetch a boot file of its own.
#
# @SET_SERVERIP@ and @TFTP_PORT@ are rewritten by build.sh. With TFTP_SERVER=
# set, @SET_SERVERIP@ becomes `setenv serverip <it>; `; without it, nothing,
# and U-Boot uses the server the lease named. TFTP_PORT (default 69) lets this
# board's TFTP server share a host with another: only one process can
# own UDP 69. CONFIG_TFTP_PORT makes U-Boot honor `tftpdstp`; the bootcmd sets
# it, so the scripted boot and any hand-typed tftpboot both go to the right
# port.
# ---------------------------------------------------------------------------
CONFIG_TFTP_PORT=y
#
# ⚠ TFTP only on a JTAG boot. board/xilinx/zynq/board.c sets `modeboot` from
# the boot-mode pins: jtagboot, qspiboot or sdboot. A board that booted from
# QSPI or SD has its own kernel to run, and making it wait out a TFTP timeout
# first would be a minute of nothing on every boot. So: netboot when a human
# JTAG-loaded this U-Boot, local media otherwise -- distro_bootcmd scans mmc0
# (SD) then mmc1 (eMMC): the SD card's FAT partition holds
# /extlinux/extlinux.conf, the eMMC root /boot/extlinux/extlinux.conf.
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if test ${modeboot} = jtagboot; then setenv autoload no; setenv tftpdstp @TFTP_PORT@; if dhcp; then @SET_SERVERIP@if tftpboot 0x3000000 rkz7100-boot.scr; then source 0x3000000; fi; fi; fi; run distro_bootcmd"

# Environment for an SD boot: uboot.env on the card's FAT partition. A QSPI
# boot saves at CONFIG_ENV_OFFSET (0xE00000) in the flash; JTAG saves nowhere.
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="mmc"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:auto"
CONFIG_ENV_FAT_FILE="uboot.env"

# Ethernet: RTL8211F-CG on ENET0 (gem0), PHY address 1.
CONFIG_PHY_REALTEK=y
CONFIG_ZYNQ_GEM=y
CONFIG_CMD_MII=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTPPUT=y

# The board's I2C buses are all on PL pins (the EEPROM holding the MAC is on
# one of them), so reaching them means bit-banging GPIOs. DM_I2C, I2C_EEPROM
# and NVMEM are already in the Xilinx defconfig; this is the missing piece.
CONFIG_DM_I2C_GPIO=y

# QSPI: 2x W25Q256FV in dual parallel = 64 MiB.
CONFIG_ZYNQ_QSPI=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_CMD_SF=y

# microSD (mmc0) and eMMC (mmc1).
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ZYNQ=y
CONFIG_CMD_MMC=y

# USB host on the USB-A connector.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_ZYNQ=y
CONFIG_USB_ULPI_VIEWPORT=y
CONFIG_USB_ULPI=y
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB=y

# ---------------------------------------------------------------------------
# Reset the USB3320 PHY before anything else runs.
#
# RESETB reaches the PHY from MIO7 through a diode, against a 10K pull-up to
# 1.8 V -- and MIO7 is also a boot strap with a 20K pull-down. After power-up
# the PS7 init leaves MIO7 as a GPIO with TRI_ENABLE=1 in its SLCR pin register
# (MIO_PIN_07 = 0x601), so NOTHING drives it: RESETB sits on the divider near
# 1.3 V and never sees a clean edge. Measured: the PHY then clocks
# (ULPI_VIEWPORT.SS = 1) but never answers a register read (ULPIRUN stuck), and
# Linux fails with `ci_hdrc: unable to init phy: -110`.
#
# A GPIO hog does NOT fix it: the GPIO block drives the pin, but TRI_ENABLE in
# the SLCR overrides it, so the "driven high" pin is still floating. What
# works, measured: clear TRI_ENABLE, pulse the pin low ~10 ms, raise it. After
# that the PHY reads vendor ID 0x0424 and stays good.
#
# The same PREBOOT then loads the PL bitstream, because three things the board
# needs live on PL pins and do not exist until it is configured:
#
#   * the fan. Its PWM and tachometer are PL pins, and PUDC_B holds the fan OFF
#     while the FPGA is unconfigured -- about 8 C of die temperature spent
#     waiting for userspace.
#   * the I2C bus carrying the EEPROM that holds both MAC addresses: this
#     PREBOOT reads eth0's (below), and Linux reads eth1's through nvmem.
#   * the MDIO bus to the PL Ethernet PHY.
#
# The bitstream comes from the medium the board booted from: `rkz7100.bin` on
# an SD card's FAT partition for an SD boot, `/boot/rkz7100.bin` on the eMMC's
# root filesystem otherwise (QSPI and JTAG boots alike). An SD card then
# carries its own bitstream, and never picks up an older one left on the eMMC.
# `if load ... then` rather than `&&`: a board with no bitstream there still
# boots, just without those three.
#
# Having configured the PL, the same PREBOOT reads the MAC address out of the
# EEPROM and forces it into `ethaddr`. Three details make that work:
#
#   * `setenv -f`. U-Boot has already invented a random MAC by this point --
#     eth probes during "Net:", which runs BEFORE preboot -- and `ethaddr` is
#     write-protected once set. Without -f the write fails with
#     "Can't overwrite ethaddr" and the random address survives.
#   * `setexpr.b` prints without leading zeros, so this builds `2:0:da:b9:ee:e`.
#     U-Boot parses each colon-separated field as hex, so that IS 02:00:...:0e;
#     `net list` confirms it.
#   * the `test ${m0} != ff` guard. A blank EEPROM reads all 0xFF, and
#     ff:ff:ff:ff:ff:ff is the broadcast address -- worse than a random one.
#
# Setting it here rather than later matters for Linux too: U-Boot stamps
# `ethaddr` into the kernel's device tree at bootm, and that property is what
# the kernel actually uses.
#
#   mw f8000008 df0d / f8000004 767b   SLCR unlock / lock
#   mw f800071c 600                    MIO7: GPIO, LVCMOS33, TRI_ENABLE=0
#   mw e000a204 80, e000a208 80        GPIO bank 0: MIO7 output, enabled
#   mw e000a000 ff7f0000 / ff7f0080    MASK_DATA_0_LSW: MIO7 low, then high
# (Bank 0's other pins are all peripherals, so writing DIRM/OEN whole is safe.)
# Linux keeps it driven afterward: see the pinctrl + hog in zynq-rkz7100.dts.
# ---------------------------------------------------------------------------
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="mw.l f8000008 df0d; mw.l f800071c 600; mw.l f8000004 767b; mw.l e000a204 80; mw.l e000a208 80; mw.l e000a000 ff7f0000; sleep 0.01; mw.l e000a000 ff7f0080; sleep 0.01; setenv bitok 0; if test ${modeboot} = sdboot; then mmc dev 0; if load mmc 0:1 0x2000000 /rkz7100.bin; then setenv bitok 1; fi; else mmc dev 1; if load mmc 1:1 0x2000000 /boot/rkz7100.bin; then setenv bitok 1; fi; fi; if test ${bitok} = 1; then fpga load 0 0x2000000 ${filesize}; if i2c dev 0 && i2c read 50 20.2 6 0x2100000; then setexpr.b m0 *0x2100000; setexpr.b m1 *0x2100001; setexpr.b m2 *0x2100002; setexpr.b m3 *0x2100003; setexpr.b m4 *0x2100004; setexpr.b m5 *0x2100005; if test ${m0} != ff; then setenv -f ethaddr ${m0}:${m1}:${m2}:${m3}:${m4}:${m5}; fi; fi; fi"

# Bring-up: a DDR test before Linux is in the picture separates a bad DDR
# configuration from a bad kernel.
CONFIG_CMD_MEMTEST=y
CONFIG_SYS_ALT_MEMTEST=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_GPIO=y
