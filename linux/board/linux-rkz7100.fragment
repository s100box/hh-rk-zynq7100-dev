# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: 2026 Howard M. Harte
#
# Kernel config additions for the RK-ZYNQ7100, on top of the Xilinx
# arch/arm/configs/xilinx_zynq_defconfig (linux-xlnx
# xlnx_rebase_v6.6_LTS_merge_6.6.70). Each entry is something the base
# defconfig does not cover and this board has.

# --- Ethernet -----------------------------------------------------------
# RTL8211F-CG. Without its own driver the generic PHY driver cannot program
# the RGMII internal delays that phy-mode = "rgmii-id" asks for.
CONFIG_REALTEK_PHY=y

# --- USB host (USB-A) ---------------------------------------------------
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# --- USB device (USB-C, zynq-rkz7100-usbdev.dtb) ------------------------
# The gadget functions rk-zynq7100-fmcomms2-linux runs on this PHY, configured
# at run time through configfs.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- GPIO hogs (MIO7, the USB PHY reset) --------------------------------
CONFIG_OF_GPIO=y

# --- Die temperature and the fan ----------------------------------------
# The XADC itself is already in the Xilinx defconfig (CONFIG_XILINX_XADC) and
# comes up as an IIO device. These put it, and the fan, where anything looking
# for a temperature or a fan expects to find them:
#
#   iio-hwmon   the XADC's temperature and rails under /sys/class/hwmon
#   pwm-cadence TTC1 as a PWM provider (the device tree's #pwm-cells picks it)
#   pwm-fan     hwmon pwm1, and the thermal zone's cooling device
CONFIG_PWM=y
CONFIG_PWM_CADENCE=y
CONFIG_SENSORS_IIO_HWMON=y
CONFIG_SENSORS_PWM_FAN=y
# A thermal zone fed from an ADC channel: the die temperature drives the fan
# with no daemon. See the thermal-zones node in board/zynq-rkz7100.dts.
CONFIG_GENERIC_ADC_THERMAL=y

# --- I2C on PL pins -----------------------------------------------------
# Every I2C bus on this board (ADV7511, ADV7611, camera/EEPROM, FMC) lands on
# PL pins, and the PS has no I2C controller wired out to them. The PL hands
# the pins to the PS as EMIO GPIOs and this bit-bangs them -- 100 kHz
# configuration buses do not justify a soft master. CONFIG_I2C and
# CONFIG_I2C_CHARDEV are already in the Xilinx defconfig.
CONFIG_I2C_GPIO=y

# The PL Ethernet port: GEM1 over EMIO through Xilinx's gmii_to_rgmii core.
# The core's speed register is written by this driver after every PHY status
# read; without it the core stays at its reset speed. It is in the tree and
# off in the Xilinx defconfig.
CONFIG_XILINX_GMII2RGMII=y

# --- Filesystems --------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FANOTIFY=y
CONFIG_VFAT_FS=y

# --- Storage / MTD ------------------------------------------------------
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_MMC_BLOCK_MINORS=16

# --- PL access from userspace (the BIST engines' interrupts) -----------
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_UIO_DMEM_GENIRQ=y

# --- HDMI CEC -----------------------------------------------------------
# The ADV7611 has a CEC block and the adv7604 driver can expose it as a
# /dev/cec device, but that support is a separate symbol and the Xilinx
# defconfig leaves it off.
#
# ⚠ This symbol alone is not enough on this board. Nothing connects the
# ADV7611's interrupt, and stock adv7604.c signals CEC transmit completion
# only from its interrupt handler -- so every frame is sent and acknowledged
# on the wire while the CEC core is never told, and each transmit times out.
# board/patches/linux/0002-adv7604-poll-... supplies the missing half by
# polling the status registers. Both are required.
#
# ⚠ The ADV7511 (HDMI out) is NOT covered by this. Its CEC lives in the DRM
# bridge driver, which needs a DRM pipeline to attach to, and this board has
# none -- so the transmit side is driven over I2C by hand.
CONFIG_VIDEO_ADV7604_CEC=y
# The camera: the OV5647 sensor and the PL's MIPI CSI-2 receiver.
CONFIG_VIDEO_OV5647=y
CONFIG_VIDEO_XILINX_CSI2RXSS=y
# Contiguous memory for the capture buffers. A 2592x1944 RAW10 frame is 10 MB
# and streaming needs at least three; the default 16 MB holds one.
CONFIG_CMA_SIZE_MBYTES=128

# --- Diagnostics --------------------------------------------------------
CONFIG_DEVMEM=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
# (No CONFIG_PROC_KCORE: /proc/kcore does not exist on 32-bit ARM, and
# kconfig drops the line without a word -- build.sh checks for that.)
